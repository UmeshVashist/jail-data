{
  "name": "informaction-node-app",
  "version": "1.0.0",
  "description": "Enterprise Data Management Web Application built with React.js, Node.js, Express, Cloudflare R2 and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=routes --watch-path=config --watch-path=middleware server.js",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:client",
    "client:dev": "cd client && npm run dev"
  },
  "keywords": [
    "react",
    "nodejs",
    "express",
    "cloudflare-r2",
    "bootstrap5",
    "data-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0"
  }
}
