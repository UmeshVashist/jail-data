# Port Configuration
PORT=3000

# Session Secret (Replace with secure random string in production)
SESSION_SECRET=your-random-production-session-secret-key-2026

# Cloudflare R2 S3-Compatible Storage Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=jam-data
